# TLS sites when DOMAIN / SANDBOX_DOMAIN are set (reference).
# Live config is generated by caddy-entrypoint.sh.
#
# Production:  topcafes.fyi  → app:3847
# Sandbox:     mark-d.dev    → sandbox-app:3847  (after cutover)
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
	reverse_proxy app:3847
}

{$SANDBOX_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
	reverse_proxy {$SANDBOX_UPSTREAM}
}
