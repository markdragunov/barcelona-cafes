# Copy to .env and fill in real values. Never commit .env.
# cp .env.example .env

PORT=3847
DATA_DIR=./data

# Storage backend: sqlite+chroma (local default) | supabase (Postgres + pgvector)
STORAGE_BACKEND=sqlite+chroma

# Postgres — only required when STORAGE_BACKEND=supabase.
# Prefer a Supabase connection string or a secrets manager.
# Local docker example (documented only; never put production passwords in source):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/barcelona_cafes
# On the droplet the app talks to the DB container over Docker DNS:
# DATABASE_URL=postgresql://postgres:<strong-password>@db:5432/barcelona_cafes
DATABASE_URL=
DATABASE_SSL=disable

# Password for the pgvector container (mirrored into DATABASE_URL).
# On the droplet this lives in /opt/barcelona-cafes-pg/.env, not here.
POSTGRES_PASSWORD=

# Optional override for local SQLite path (defaults to $DATA_DIR/cafes.db)
# SQLITE_PATH=

# Google Places API (New) + Geocoding API
GOOGLE_PLACES_API_KEY=
GOOGLE_API_KEY=

# Parallel Extract
PARALLEL_API_KEY=

# OpenAI embeddings + chat answers
OPENAI_API_KEY=

# --- Public search cost controls (POST /api/rag/search is unauthenticated) ---
# Window shared by both search rate limits, in milliseconds.
# SEARCH_RATE_LIMIT_WINDOW_MS=60000
# Requests per window per client address (keyed on req.ip, not X-Forwarded-For).
# SEARCH_RATE_LIMIT_MAX=30
# Requests per window across all clients — bounds the cost of a distributed flood.
# SEARCH_GLOBAL_RATE_LIMIT_MAX=120
# Longest accepted query; longer bodies are rejected with 400 before billing.
# SEARCH_MAX_QUERY_CHARS=300
# Cache for identical queries (same text + topN). Set to 0 to disable.
# SEARCH_CACHE_TTL_MS=300000
# SEARCH_CACHE_MAX_ENTRIES=200

# --- Admin auth (Supabase magic link preferred) ---
# Project URL + anon key (anon is public; used by the admin login UI)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Legacy HS256 JWT secret (Project Settings → JWT Keys).
# Leave empty on projects that use asymmetric JWT signing keys — tokens are then
# verified against the project JWKS, which only needs SUPABASE_URL.
SUPABASE_JWT_SECRET=
# Comma-separated allowlist — only these emails can use admin APIs
ADMIN_EMAILS=
# Service role — invite script only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Optional redirect used by scripts/invite-admin.js
# ADMIN_INVITE_REDIRECT=https://topcafes.fyi/admin

# Legacy HTTP Basic (used only when Supabase Auth env above is incomplete)
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Environments (three stacks; admin is always /admin on the same host) ---
#
# Local (laptop): http://localhost:3847/ and http://localhost:3847/admin
#   STORAGE_BACKEND=sqlite+chroma  (this file's default)
#   Do not set DOMAIN. npm start — no Caddy required.
#
# Production (droplet /opt/barcelona-cafes + /opt/barcelona-cafes-pg):
#   Public https://topcafes.fyi/   Admin https://topcafes.fyi/admin
#   STORAGE_BACKEND=supabase
#   DATABASE_URL=postgresql://postgres:<pw>@db:5432/barcelona_cafes
#   DOMAIN=topcafes.fyi
#   After DNS exists, production Site URL in Supabase Auth is https://topcafes.fyi/admin
#
# Sandbox (droplet /opt/barcelona-cafes-sandbox + /opt/barcelona-cafes-sandbox-pg):
#   Public https://mark-d.dev/   Admin https://mark-d.dev/admin
#   Own compose project + own Postgres volume (does not share cafe data with prod).
#   DOMAIN is unused on the sandbox compose file; production Caddy routes it:
#   SANDBOX_DOMAIN=mark-d.dev
#   SANDBOX_UPSTREAM=sandbox-app:3847
#
# Until topcafes.fyi has an A record, keep DOMAIN=topcafes.fyi,mark-d.dev and
# leave SANDBOX_DOMAIN empty so the live URL still serves production data.
# Cutover: deploy/cutover-sandbox-caddy.sh (only when prod DNS works).
#
# DOMAIN=topcafes.fyi
# SANDBOX_DOMAIN=mark-d.dev
# SANDBOX_UPSTREAM=sandbox-app:3847
# ADMIN_DOMAIN=
