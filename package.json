{
  "name": "barcelona-cafes",
  "version": "1.0.0",
  "private": true,
  "description": "Collect Barcelona cafes via Google Places API (New) into local SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/**/*.test.js",
    "test:py": "python3 -m unittest discover -s tests -v",
    "rag:status": "python3 -m rag status",
    "setup:python": "python3 -m pip install -r requirements.txt",
    "db:up": "./scripts/pgvector-up.sh",
    "db:migrate": "python3 scripts/apply_migrations.py",
    "db:etl": "python3 scripts/migrate_sqlite_to_supabase.py",
    "admin:invite": "node scripts/invite-admin.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "pg": "^8.23.0"
  }
}
